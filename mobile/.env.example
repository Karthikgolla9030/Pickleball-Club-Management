# ==============================================================================
# Aught2 Pickleball — Mobile / Web Client Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# IMPORTANT: Only variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER place private database URLs, signing keys, or server secrets in this file.
# ==============================================================================

# Backend API base URL:
# - Local web/simulator: http://localhost:8000
# - Physical device testing (LAN): http://<YOUR_LOCAL_IP>:8000
# - Staging / Production: https://pickleball-club-management.onrender.com
# (When deployed on Vercel with vercel.json rewrites, /api is reverse-proxied to Render)
EXPO_PUBLIC_API_URL=http://localhost:8000
