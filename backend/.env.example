# ==============================================================================
# Aught2 Pickleball — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide appropriate environment values.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment ('development', 'staging', 'production', 'test')
APP_ENV=development
APP_NAME=Aught2 Pickleball API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database Connection URL
# Development example:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aught2_pickleball
# Production / Staging example (Neon PostgreSQL with SSL):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<ep-id>.<region>.aws.neon.tech/<dbname>?sslmode=require

# JWT Authentication
# In production, JWT_SECRET_KEY MUST be at least 32 characters, cryptographically random.
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-cryptographically-random-32-byte-hex-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Dedicated Migration Secret (Optional in production)
# If provided, enables /api/v1/system/run-migrations protected by X-Migration-Secret header.
# MUST NOT match JWT_SECRET_KEY. If omitted, the runtime migration endpoint is disabled (404).
# MIGRATION_SECRET=replace-with-dedicated-migration-secret-if-remote-trigger-required

# Allowed CORS Origins
# In production, must be specific domains (no wildcards allowed).
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","https://pickleball-club-management.vercel.app"]

# Authorized Platform Owners
# Explicit list of email addresses authorized to review, approve, and reject new club applications.
# Distinct from club staff roles (club_owner, club_manager, tournament_director).
PLATFORM_OWNER_EMAILS=["platform.owner@aught2.com","platform@aught2.com"]
