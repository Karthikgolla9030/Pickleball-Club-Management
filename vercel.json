{
  "version": 2,
  "outputDirectory": "mobile/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pickleball-club-management.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://pickleball-club-management.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|_expo/|icons/|favicon.png|manifest.json|sw.js|offline.html|api/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
